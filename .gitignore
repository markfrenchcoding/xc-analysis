backtest/raw/
backtest/data/*-single.csv
backtest/data/*-common.csv
backtest/data/*-x*.csv
_new_index.html
pull/.probe.json
pull/.commit-msg
pull/last-run.log
pull/.crawl-state.json
# per-machine tool approvals, not a project setting
.claude/settings.local.json

# Who's Who source PDFs: 6MB, re-fetchable, and the committed .txt is what
# the parser actually reads.
pull/whoswho/raw/

# local preview server, per-machine
.claude/launch.json

# the bio cache is a resume file, not data
pull/roster/*_bio.jsonl

# the audit baseline is a working file, regenerated with --baseline, and
# there is one per school now
pull/roster/.page-baseline*.json

# screenshots taken while checking a layout; regenerated on demand
look/

# race-rated backtest seeds other than the one publish.js reads; they rebuild in
# seconds with build_season.js --race=...
backtest/data/*-race0.csv
backtest/data/*-race-0.5.csv
backtest/data/*-race-1.5.csv
backtest/data/*-trend*.csv
backtest/data/*-drace*.csv

# the history pull's log, per machine
backtest/pull-history.log
